# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=sift
POSTGRES_PASSWORD=sift_dev_password
POSTGRES_DB=sift
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Empty locally. Managed providers (e.g. Neon) require "require" — see
# docs/DEPLOYMENT.md, never set this for local Docker Compose Postgres.
POSTGRES_SSLMODE=

# --- Generation provider (Groq free API) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- Auth (JWT signing) ---
# Has a dev-only default (see app/config.py), safe for local use, never for a
# real deployment. Set a real, random secret before deploying anywhere real.
JWT_SECRET_KEY=
